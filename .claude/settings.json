{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "command": "root=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null)}\"; [ -n \"$root\" ] && git -C \"$root\" checkout HEAD -- .beads/issues.jsonl .beads/interactions.jsonl 2>/dev/null; true",
            "type": "command",
            "statusMessage": "Discarding passive bd export churn"
          }
        ],
        "matcher": ""
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Agent(*)",
      "Read(docs/**)",
      "Write(docs/**)",
      "Edit(docs/**)",
      "Read(scripts/**)",
      "Read(.claude/**)",
      "Write(.claude/worktrees/**)",
      "Edit(.claude/worktrees/**)",
      "Bash(git *)",
      "Bash(bash -c *)",
      "Bash(python3 *)",
      "Bash(uv *)",
      "Bash(pytest *)",
      "Bash(nox *)",
      "Bash(ruff *)",
      "Bash(docker *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(rm *)",
      "Bash(chmod *)",
      "Bash(./scripts/*)"
    ]
  },
  "spinnerTipsEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "in=$(cat); d=$(printf '%s' \"$in\" | jq -r '.workspace.project_dir // .cwd // empty'); printf '%s' \"$in\" | bash \"$d/.claude/statusline.sh\""
  },
  "worktree": {
    "baseRef": "head"
  }
}